# Convex — `npx convex dev` writes CONVEX_DEPLOYMENT and prints the URL.
NEXT_PUBLIC_CONVEX_URL=

# Clerk (dashboard -> API keys). The publishable key is public; the secret
# key is not. Create a JWT template named "convex" and set its issuer domain
# on the Convex side: `npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Absolute URL of the web app, used to build invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
